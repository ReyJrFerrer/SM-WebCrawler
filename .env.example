# SM Markets GraphQL source
SM_GRAPHQL_URL=https://smmarkets.ph/graphql
SM_CATEGORY_ID=2398
SM_PAGE_SIZE=100
MAX_PAGES_PER_RUN=100
FETCH_TIMEOUT_MS=20000
MAX_FETCH_RETRIES=2

# Logical labels
SOURCE_NAME=smmarkets-graphql
STORE_CONTEXT=SM_MARKETS_ONLINE

# Snapshot plausibility guard (new_count / previous_count)
MIN_SNAPSHOT_RATIO=0.5

# Google Sheets
SPREADSHEET_ID=your-spreadsheet-id
# Path to a service-account JSON key file (recommended), JSON string, or base64-encoded JSON
# The file must grant Editor access to the target spreadsheet
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json

# Cron authorization
# Required in production. Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret
# Development-only bypass; ignored when VERCEL_ENV=production
ALLOW_LOCAL_CRON=true

# Observability
CRAWLER_VERSION=
# VERCEL_ENV and VERCEL_GIT_COMMIT_SHA are provided by Vercel when deployed
